<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <!-- Insets keep the highlight from touching the container edges -->
        <inset android:insetLeft="12dp" android:insetRight="12dp" android:insetTop="6dp" android:insetBottom="6dp">
            <shape android:shape="rectangle">
                <!-- 15% opacity gold pill -->
                <solid android:color="#26E08B3D" />
                <corners android:radius="23dp" />
            </shape>
        </inset>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>

