<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:animateLayoutChanges="true">

    <LinearLayout
        android:id="@+id/ll_logo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="64dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pendaftaran"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lengkapi profil belajarmu"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_step_indicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingTop="32dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/ll_logo">

        <View
            android:id="@+id/step_1"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/bg_button_primary_modern"/>
        <View
            android:id="@+id/line_1"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_weight="1"
            android:background="@color/color_accent_gold"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>

        <View
            android:id="@+id/step_2"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/bg_input_modern"/>
        <View
            android:id="@+id/line_2"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_weight="1"
            android:background="@color/divider"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>

        <View
            android:id="@+id/step_3"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/bg_input_modern"/>
        <View
            android:id="@+id/line_3"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_weight="1"
            android:background="@color/divider"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>

        <View
            android:id="@+id/step_4"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/bg_input_modern"/>
    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_register"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/ll_step_indicator"
        app:layout_constraintBottom_toTopOf="@id/ll_login_link"/>

    <LinearLayout
        android:id="@+id/ll_login_link"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="24dp"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@id/ll_nav_buttons">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sudah memiliki akun?"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tv_go_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Masuk"
            android:textColor="@color/color_accent_gold"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_nav_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="24dp"
        android:gravity="center_vertical"
        android:background="@color/bg_card"
        android:elevation="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="Kembali"
            android:textColor="@color/text_secondary"
            android:background="@drawable/bg_input_modern"
            app:backgroundTint="@null"
            android:visibility="gone"
            android:layout_marginEnd="16dp"
            android:elevation="0dp"
            android:textStyle="bold"
            android:textSize="16sp"
            android:stateListAnimator="@null"/>

        <Button
            android:id="@+id/btn_next"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="Lanjut"
            android:textColor="@color/text_inverse"
            android:textStyle="bold"
            android:textSize="16sp"
            android:background="@drawable/bg_button_primary_modern"
            app:backgroundTint="@null"
            android:elevation="8dp"
            android:stateListAnimator="@null"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

